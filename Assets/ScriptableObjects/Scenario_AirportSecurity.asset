  m_Script: {fileID: 11500000, guid: d38d3761454ca6747a1fb61478912ac9, type: 3}
  m_Name: Scenario_AirportSecurity
  m_EditorClassIdentifier: 
  displayName: "\u0410\u044D\u0440\u043E\u043F\u043E\u0440\u0442: \u0441\u043B\u0443\u0436\u0431\u0430
    \u0434\u043E\u0441\u043C\u043E\u0442\u0440\u0430"
  groups:
  - title: "\u041F\u0440\u043E\u0432\u0435\u0440\u043A\u0430 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u043E\u0432"
    briefing: "\u041F\u043E\u0434\u043E\u0439\u0434\u0438\u0442\u0435 \u043A \u0441\u0442\u043E\u0439\u043A\u0435
      \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0438 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u043E\u0432,
      \u0432\u043E\u0437\u044C\u043C\u0438\u0442\u0435 \u043F\u0430\u0441\u043F\u043E\u0440\u0442
      \u043F\u0430\u0441\u0441\u0430\u0436\u0438\u0440\u0430 \u0438 \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u0435,
      \u0447\u0442\u043E \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u0435\u043D."
    steps:
    - description: "\u041F\u043E\u0434\u043E\u0439\u0442\u0438 \u043A \u0441\u0442\u043E\u0439\u043A\u0435
        \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0438 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u043E\u0432"
      orderedActions: 0
      actions:
      - description: "\u0412\u0441\u0442\u0430\u0442\u044C \u0432 \u043F\u043E\u0434\u0441\u0432\u0435\u0447\u0435\u043D\u043D\u0443\u044E
          \u0437\u043E\u043D\u0443 \u0443 \u0441\u0442\u043E\u0439\u043A\u0438"
        expectedType: 0
        targetId: zone_documents
    - description: "\u0412\u0437\u044F\u0442\u044C \u043F\u0430\u0441\u043F\u043E\u0440\u0442
        \u043F\u0430\u0441\u0441\u0430\u0436\u0438\u0440\u0430"
      orderedActions: 0
      actions:
      - description: "\u0412\u0437\u044F\u0442\u044C \u043F\u0430\u0441\u043F\u043E\u0440\u0442
          \u0441\u043E \u0441\u0442\u043E\u0439\u043A\u0438"
        expectedType: 1
        targetId: passport
    - description: "\u041F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u044C
        \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C
        \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430"
      orderedActions: 0
      actions:
      - description: "\u041D\u0430\u0436\u0430\u0442\u044C \xAB\u0414\u043E\u043A\u0443\u043C\u0435\u043D\u0442
          \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u0435\u043D\xBB"
        expectedType: 3
        targetId: btn_document_valid
  - title: "\u0414\u043E\u0441\u043C\u043E\u0442\u0440 \u0431\u0430\u0433\u0430\u0436\u0430"
    briefing: "\u041F\u043E\u0434\u043E\u0439\u0434\u0438\u0442\u0435 \u043A \u043B\u0435\u043D\u0442\u0435
      \u0434\u043E\u0441\u043C\u043E\u0442\u0440\u0430, \u0432\u044B\u0431\u0435\u0440\u0438\u0442\u0435
      \u043B\u0443\u0447\u043E\u043C \u0441\u0443\u043C\u043A\u0443, \u043D\u0430
      \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u0441\u0440\u0430\u0431\u043E\u0442\u0430\u043B
      \u0441\u043A\u0430\u043D\u0435\u0440 (\u043A\u0440\u0430\u0441\u043D\u0430\u044F),
      \u0438 \u043E\u0442\u043F\u0440\u0430\u0432\u044C\u0442\u0435 \u0435\u0451
      \u043D\u0430 \u0440\u0443\u0447\u043D\u043E\u0439 \u0434\u043E\u0441\u043C\u043E\u0442\u0440."
    steps:
    - description: "\u041F\u043E\u0434\u043E\u0439\u0442\u0438 \u043A \u043B\u0435\u043D\u0442\u0435
        \u0434\u043E\u0441\u043C\u043E\u0442\u0440\u0430"
      orderedActions: 0
      actions:
      - description: "\u0412\u0441\u0442\u0430\u0442\u044C \u0432 \u043F\u043E\u0434\u0441\u0432\u0435\u0447\u0435\u043D\u043D\u0443\u044E
          \u0437\u043E\u043D\u0443 \u0443 \u043B\u0435\u043D\u0442\u044B"
        expectedType: 0
        targetId: zone_baggage
    - description: "\u0412\u044B\u0431\u0440\u0430\u0442\u044C \u043F\u043E\u0434\u043E\u0437\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u0443\u044E
        \u0441\u0443\u043C\u043A\u0443"
      orderedActions: 0
      actions:
      - description: "\u0412\u044B\u0431\u0440\u0430\u0442\u044C \u043B\u0443\u0447\u043E\u043C
          \u043A\u0440\u0430\u0441\u043D\u0443\u044E \u0441\u0443\u043C\u043A\u0443"
        expectedType: 2
        targetId: bag_suspicious
    - description: "\u041E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C \u0441\u0443\u043C\u043A\u0443
        \u043D\u0430 \u0440\u0443\u0447\u043D\u043E\u0439 \u0434\u043E\u0441\u043C\u043E\u0442\u0440"
      orderedActions: 0
      actions:
      - description: "\u041D\u0430\u0436\u0430\u0442\u044C \xAB\u041D\u0430 \u0440\u0443\u0447\u043D\u043E\u0439
          \u0434\u043E\u0441\u043C\u043E\u0442\u0440\xBB"
        expectedType: 3
        targetId: btn_baggage_inspect
  - title: "\u041F\u043E\u0441\u0430\u0434\u043A\u0430 \u043D\u0430 \u0440\u0435\u0439\u0441"
    briefing: "\u041F\u043E\u0434\u043E\u0439\u0434\u0438\u0442\u0435 \u043A \u0432\u044B\u0445\u043E\u0434\u0443
      \u043D\u0430 \u043F\u043E\u0441\u0430\u0434\u043A\u0443, \u0432\u043E\u0437\u044C\u043C\u0438\u0442\u0435
      \u043F\u043E\u0441\u0430\u0434\u043E\u0447\u043D\u044B\u0439 \u0442\u0430\u043B\u043E\u043D
      \u0438 \u043E\u0442\u0441\u043A\u0430\u043D\u0438\u0440\u0443\u0439\u0442\u0435
      \u0435\u0433\u043E \u043D\u0430 \u0442\u0435\u0440\u043C\u0438\u043D\u0430\u043B\u0435,
      \u0437\u0430\u0442\u0435\u043C \u043E\u0442\u043A\u0440\u043E\u0439\u0442\u0435
      \u043F\u0440\u043E\u0445\u043E\u0434."
    steps:
    - description: "\u041F\u043E\u0434\u043E\u0439\u0442\u0438 \u043A \u0432\u044B\u0445\u043E\u0434\u0443
        \u043D\u0430 \u043F\u043E\u0441\u0430\u0434\u043A\u0443"
      orderedActions: 0
      actions:
      - description: "\u0412\u0441\u0442\u0430\u0442\u044C \u0432 \u043F\u043E\u0434\u0441\u0432\u0435\u0447\u0435\u043D\u043D\u0443\u044E
          \u0437\u043E\u043D\u0443 \u0443 \u0432\u044B\u0445\u043E\u0434\u0430"
        expectedType: 0
        targetId: zone_gate
    - description: "\u041F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C \u043F\u043E\u0441\u0430\u0434\u043E\u0447\u043D\u044B\u0439
        \u0442\u0430\u043B\u043E\u043D"
      orderedActions: 0
      actions:
      - description: "\u0412\u0437\u044F\u0442\u044C \u043F\u043E\u0441\u0430\u0434\u043E\u0447\u043D\u044B\u0439
          \u0442\u0430\u043B\u043E\u043D"
        expectedType: 1
        targetId: boarding_pass
      - description: "\u0412\u044B\u0431\u0440\u0430\u0442\u044C \u043B\u0443\u0447\u043E\u043C
          \u0442\u0435\u0440\u043C\u0438\u043D\u0430\u043B \u0441\u043A\u0430\u043D\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F"
        expectedType: 2
        targetId: gate_scanner
    - description: "\u041E\u0442\u043A\u0440\u044B\u0442\u044C \u043F\u0440\u043E\u0445\u043E\u0434
        \u043D\u0430 \u043F\u043E\u0441\u0430\u0434\u043A\u0443"
      orderedActions: 0
      actions:
      - description: "\u041D\u0430\u0436\u0430\u0442\u044C \xAB\u041E\u0442\u043A\u0440\u044B\u0442\u044C
          \u043F\u0440\u043E\u0445\u043E\u0434\xBB"
        expectedType: 3
        targetId: btn_gate_open
